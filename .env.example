# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
# The backend listens here; all dev URLs below assume 3002.
PORT=3002

# ── Database (Supabase Postgres via Prisma 7) ─────────────────────────────
# Runtime pool — on Supabase use the pooled (port 6543, pgbouncer) URL.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/syncit
# Prisma CLI (migrate/db pull) — MUST be the direct (port 5432) URL, never
# the pooler; prisma.config.ts reads only this for migrations.
DIRECT_URL=postgresql://user:password@127.0.0.1:5432/syncit
# Optional: only needed for `prisma migrate diff --from-migrations` drift
# checks (point it at an empty scratch database).
# SHADOW_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/syncit_shadow

# ── Redis (REQUIRED: sessions cache, OAuth state nonces, sync locks, rate
#    limits — login does not work without it) ─────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Sessions & security ───────────────────────────────────────────────────
# Session lifetime in seconds (default 1 day).
SESSION_TTL=86400
# 32 random bytes, base64 — encrypts OAuth tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# ── Frontend wiring ───────────────────────────────────────────────────────
# Where OAuth callbacks redirect users after login/connect.
# Dev MUST be 127.0.0.1 (not localhost): Spotify only accepts loopback-IP
# redirect URIs and session cookies are host-scoped.
FRONTEND_URL=http://127.0.0.1:3000
# Comma-separated CORS allowlist (browser origins that may call this API).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Google / YouTube OAuth (https://console.cloud.google.com) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev values. In production, point these at the CLIENT domain's proxy path
# (e.g. https://app.example.com/api/backend/google/callback) and register
# the same URLs in the Google Cloud Console.
# TODO(owner): replace with real production URLs before deploying.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3002/google/callback
YOUTUBE_REDIRECT_URI=http://127.0.0.1:3002/youtube/callback

# YouTube Data API v3 key (https://console.cloud.google.com)
YOUTUBE_API_KEY=

# ── Spotify OAuth (https://developer.spotify.com/dashboard) ───────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify rejects `localhost` — loopback IP is mandatory in dev.
# TODO(owner): replace with the production proxy-path URL (e.g.
# https://app.example.com/api/backend/spotify/callback) and register it in
# the Spotify developer dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3002/spotify/callback

# ── Google AI (Gemini 2.5 Flash — LLM track matching) ─────────────────────
GOOGLE_API_KEY=
