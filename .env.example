# Server
NODE_ENV=development
PORT=8000

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/syncit

# Redis (session store and cron locks)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Session
SESSION_TTL=86400   # seconds; default 1 day

# Frontend origin (used for OAuth redirects and CORS)
FRONTEND_URL=http://localhost:3000

# Google / YouTube OAuth  (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# YouTube Data API v3 key  (https://console.cloud.google.com)
YOUTUBE_API_KEY=

# Spotify OAuth  (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

# Google AI (Gemini 2.5 Flash — used for LLM track matching)
GOOGLE_API_KEY=
